
#include <iostream>
using namespace std;

class book
{
public:
    int bookid;
    string book_name;
    float price;

    void input()
    {
        cout << "Enter Book ID: ";
        cin >> bookid;

        cout << "Enter Book Name: ";
        cin >> book_name;

        cout << "Enter Book Price: ";
        cin >> price;
    }

    void display()
    {
        cout << "Book ID: " << bookid << endl;
        cout << "Book Name: " << book_name << "\n";
        cout << "Book Price: " << price;
    }
};

int main()
{
    book b1;

    b1.input();
    b1.display();

    return 0;
}